# Modele de configuration - CE fichier est versionne, il ne contient AUCUN secret.
# Copier en .env et y renseigner les vraies valeurs. Le .env, lui, est ignore par git.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=epicevents
DB_USER=epicevents_app
DB_PASSWORD=a_renseigner_dans_le_fichier_.env

# Cle de signature des jetons JWT. A generer avec :
#     python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=a_generer_puis_coller_dans_le_fichier_.env
